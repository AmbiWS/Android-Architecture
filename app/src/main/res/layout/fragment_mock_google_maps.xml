<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivGoogleMaps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/mock_google_map" />

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_gray_round"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_arrow_left_center" />

    <ImageView
        android:id="@+id/ivSearch"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_gray_round"
        android:padding="13dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivBack"
        app:srcCompat="@drawable/ic_search" />

    <ImageView
        android:id="@+id/ivHome1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="145dp"
        android:layout_marginTop="240dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/home" />

    <ImageView
        android:id="@+id/ivHome2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="308dp"
        android:layout_marginTop="282dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/home" />

    <ImageView
        android:id="@+id/ivHomeSelectedBg"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivHome3"
        app:layout_constraintEnd_toEndOf="@+id/ivHome3"
        app:layout_constraintStart_toStartOf="@+id/ivHome3"
        app:layout_constraintTop_toTopOf="@+id/ivHome3"
        app:srcCompat="@drawable/bg_gray_round" />

    <ImageView
        android:id="@+id/ivHome3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="110dp"
        android:layout_marginTop="420dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/home_selected" />

    <TextView
        android:id="@+id/tvHome1"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_white_round"
        android:fontFamily="@font/poppins_medium"
        android:paddingHorizontal="12dp"
        android:paddingVertical="2dp"
        android:text="$215,000"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@+id/ivHome1"
        app:layout_constraintStart_toStartOf="@+id/ivHome1"
        app:layout_constraintTop_toBottomOf="@+id/ivHome1" />

    <TextView
        android:id="@+id/tvHome2"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_white_round"
        android:fontFamily="@font/poppins_medium"
        android:paddingHorizontal="12dp"
        android:paddingVertical="2dp"
        android:text="$350,000"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@+id/ivHome2"
        app:layout_constraintStart_toStartOf="@+id/ivHome2"
        app:layout_constraintTop_toBottomOf="@+id/ivHome2" />

    <TextView
        android:id="@+id/tvHome3"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_white_round"
        android:fontFamily="@font/poppins_bold"
        android:paddingHorizontal="12dp"
        android:paddingVertical="2dp"
        android:text="$500,000"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@+id/ivHome3"
        app:layout_constraintStart_toStartOf="@+id/ivHome3"
        app:layout_constraintTop_toBottomOf="@+id/ivHome3" />

    <include
        layout="@layout/item_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/ivGoogleMaps"
        app:layout_constraintStart_toStartOf="@id/ivGoogleMaps" />
</androidx.constraintlayout.widget.ConstraintLayout>