<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivHome"
        android:layout_width="0dp"
        android:layout_height="400dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/home_picture" />

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_gray_round128"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_arrow_left_center" />

    <View
        android:id="@+id/viewPhotoBg"
        android:layout_width="64dp"
        android:layout_height="32dp"
        android:layout_marginStart="24dp"
        android:background="@drawable/bg_dkgray_round128"
        app:layout_constraintBottom_toBottomOf="@id/ivPhoto"
        app:layout_constraintEnd_toEndOf="@+id/ivPhoto"
        app:layout_constraintStart_toStartOf="@+id/ivPhoto"
        app:layout_constraintTop_toTopOf="@+id/ivPhoto" />

    <ImageView
        android:id="@+id/ivPhoto"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:padding="8dp"
        android:paddingStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivHome"
        app:layout_constraintStart_toStartOf="@+id/ivBack"
        app:srcCompat="@drawable/ic_photo" />

    <TextView
        android:id="@+id/tvPhoto"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="12"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/viewPhotoBg"
        app:layout_constraintEnd_toEndOf="@+id/viewPhotoBg"
        app:layout_constraintStart_toEndOf="@+id/ivPhoto"
        app:layout_constraintTop_toTopOf="@id/viewPhotoBg" />

    <TextView
        android:id="@+id/tvAddress"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dkwhite_round4"
        android:elevation="6dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="115 Lake Rd Streed, OK 56720"
        app:layout_constraintBottom_toBottomOf="@+id/ivHome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivHome" />

    <TextView
        android:id="@+id/tvPrice"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppins_medium"
        android:text="$500,000"
        android:textSize="40sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAddress" />

    <View
        android:id="@+id/viewDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:background="@color/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPrice" />

    <ImageView
        android:id="@+id/ivBedrooms"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="82dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewDivider"
        app:srcCompat="@drawable/ic_bed" />

    <TextView
        android:id="@+id/tvBedrooms"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/poppins_medium"
        android:text="4"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/ivBedrooms"
        app:layout_constraintStart_toEndOf="@+id/ivBedrooms"
        app:layout_constraintTop_toTopOf="@+id/ivBedrooms" />

    <ImageView
        android:id="@+id/ivSquare"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivBedrooms"
        app:layout_constraintEnd_toStartOf="@+id/tvSquare"
        app:layout_constraintTop_toTopOf="@+id/ivBedrooms"
        app:srcCompat="@drawable/ic_square" />

    <TextView
        android:id="@+id/tvSquare"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="82dp"
        android:fontFamily="@font/poppins_medium"
        android:text="95m²"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/ivSquare"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivSquare" />

    <ImageView
        android:id="@+id/ivBathrooms"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivBedrooms"
        app:layout_constraintEnd_toStartOf="@+id/ivSquare"
        app:layout_constraintStart_toEndOf="@+id/tvBedrooms"
        app:layout_constraintTop_toTopOf="@+id/ivBedrooms"
        app:srcCompat="@drawable/ic_bath" />

    <TextView
        android:id="@+id/tvBathrooms"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/poppins_medium"
        android:text="2"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/ivBathrooms"
        app:layout_constraintStart_toEndOf="@+id/ivBathrooms"
        app:layout_constraintTop_toTopOf="@+id/ivBathrooms" />

    <ImageView
        android:id="@+id/ivWifi"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="110dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivBedrooms"
        app:srcCompat="@drawable/ic_wifi" />

    <TextView
        android:id="@+id/tvWifi"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/poppins_medium"
        android:text="100 MBps"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/ivWifi"
        app:layout_constraintStart_toEndOf="@+id/ivWifi"
        app:layout_constraintTop_toTopOf="@+id/ivWifi" />

    <ImageView
        android:id="@+id/ivGarage"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivWifi"
        app:layout_constraintEnd_toStartOf="@+id/tvGarage"
        app:layout_constraintTop_toTopOf="@+id/ivWifi"
        app:srcCompat="@drawable/ic_garage" />

    <TextView
        android:id="@+id/tvGarage"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="124dp"
        android:fontFamily="@font/poppins_medium"
        android:text="3"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/ivGarage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivGarage" />

    <View
        android:id="@+id/viewDivider2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:background="@color/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvWifi" />

    <TextView
        android:id="@+id/tvInfo"
        style="@style/TextSecondary14"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:justificationMode="inter_word"
        android:text="Phasellus vehicula lacus sit amet mi efficitur, et hendrerit ante semper. Morbi lobortis sapien vel consectetur lacinia. Nulla sodales blandit mattis. Mauris dolor dolor, auctor in lectus at, congue fringilla neque. Aenean dignissim lorem lectus, vel commodo risus placerat vestibulum. Vestibulum massa enim, lobortis eget euismod ut, eleifend eu est. Nunc quis aliquet orci, tempus luctus quam. Nunc ultrices nunc id molestie vulputate. Nulla accumsan et lorem placerat pellentesque. Fusce lorem dui, feugiat et orci ac, laoreet dictum odio. Curabitur eget feugiat velit, quis malesuada eros. Aenean mollis libero eget nibh faucibus tincidunt. Nulla eu varius libero."
        android:textSize="13dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewDivider2" />
</androidx.constraintlayout.widget.ConstraintLayout>