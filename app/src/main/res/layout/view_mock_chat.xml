<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <View
        android:id="@+id/bgChat"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginVertical="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="80dp"
        android:background="@drawable/bg_snow_white_round24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivAttach"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/bgChat"
        app:layout_constraintStart_toStartOf="@+id/bgChat"
        app:layout_constraintTop_toTopOf="@+id/bgChat"
        app:srcCompat="@drawable/ic_attach" />

    <TextView
        android:id="@+id/tvChat"
        style="@style/TextSecondary14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Enter your message..."
        app:layout_constraintBottom_toBottomOf="@+id/ivAttach"
        app:layout_constraintStart_toEndOf="@+id/ivAttach"
        app:layout_constraintTop_toTopOf="@+id/ivAttach" />

    <ImageView
        android:id="@+id/ivSend"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/bgChat"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bgChat"
        app:layout_constraintTop_toTopOf="@+id/bgChat"
        app:srcCompat="@drawable/ic_send" />
</androidx.constraintlayout.widget.ConstraintLayout>