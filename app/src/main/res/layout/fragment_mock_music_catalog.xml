<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_blue_to_black">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivUser"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/Circular50"
        app:srcCompat="@drawable/img_user_picture" />

    <ImageView
        android:id="@+id/ivNotification"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivUser"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivUser"
        app:srcCompat="@drawable/ic_notification" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:drawableStart="@drawable/ic_music"
        android:drawablePadding="4dp"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="Ambi Music App"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/ivUser"
        app:layout_constraintEnd_toStartOf="@+id/ivNotification"
        app:layout_constraintStart_toEndOf="@+id/ivUser"
        app:layout_constraintTop_toTopOf="@+id/ivUser" />

    <View
        android:id="@+id/bgSearch"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_semiblack_round128"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivUser" />

    <ImageView
        android:id="@+id/ivSearch"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/bgSearch"
        app:layout_constraintStart_toStartOf="@+id/bgSearch"
        app:layout_constraintTop_toTopOf="@+id/bgSearch"
        app:srcCompat="@drawable/ic_search" />

    <TextView
        android:id="@+id/tvSearch"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Search"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/ivSearch"
        app:layout_constraintStart_toEndOf="@+id/ivSearch"
        app:layout_constraintTop_toTopOf="@+id/ivSearch" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivCover1"
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:layout_marginTop="32dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="@+id/bgSearch"
        app:layout_constraintStart_toStartOf="@+id/bgSearch"
        app:layout_constraintTop_toBottomOf="@+id/bgSearch"
        app:shapeAppearanceOverlay="@style/Circular10"
        app:srcCompat="@drawable/img_album_cover4" />

    <TextView
        android:id="@+id/tvAlbumTitle"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppins_semibold"
        android:lineHeight="32dp"
        android:text="Best\nChoice"
        android:textColor="@color/white"
        android:textSize="32sp"
        app:layout_constraintStart_toStartOf="@+id/ivCover1"
        app:layout_constraintTop_toTopOf="@+id/ivCover1" />

    <TextView
        android:id="@+id/tvDuration"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_semiblack_round128"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="55 min"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="@+id/ivCover1"
        app:layout_constraintStart_toStartOf="@+id/ivCover1" />

    <ImageView
        android:id="@+id/ivPlay"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_semiblack_round128"
        android:paddingStart="6dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivCover1"
        app:layout_constraintEnd_toEndOf="@+id/ivCover1"
        app:layout_constraintStart_toStartOf="@+id/ivCover1"
        app:layout_constraintTop_toTopOf="@+id/ivCover1"
        app:srcCompat="@android:drawable/ic_media_play" />

    <TextView
        android:id="@+id/tvForYou"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="For You"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@+id/ivCover1"
        app:layout_constraintTop_toBottomOf="@+id/ivCover1" />

    <TextView
        android:id="@+id/tvPlayAll"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Play All"
        android:textAllCaps="true"
        android:textColor="@color/lt_red"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/tvForYou"
        app:layout_constraintEnd_toEndOf="@+id/ivCover1"
        app:layout_constraintTop_toTopOf="@+id/tvForYou" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivCover2"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="32dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="@+id/ivCover1"
        app:layout_constraintTop_toBottomOf="@+id/tvForYou"
        app:shapeAppearanceOverlay="@style/Circular10"
        app:srcCompat="@drawable/img_album_cover1" />

    <TextView
        android:id="@+id/tvSong1"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Nulla congue"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/ivCover2"
        app:layout_constraintTop_toTopOf="@+id/ivCover2" />

    <TextView
        android:id="@+id/tvArtist1"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/poppins_regular"
        android:text="Condimentum"
        android:textColor="@color/snow_white"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@+id/ivCover2"
        app:layout_constraintStart_toEndOf="@+id/ivCover2" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivCover3"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="@+id/ivCover1"
        app:layout_constraintTop_toBottomOf="@+id/ivCover2"
        app:shapeAppearanceOverlay="@style/Circular10"
        app:srcCompat="@drawable/img_album_cover2" />

    <TextView
        android:id="@+id/tvSong2"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Nullam sem erat"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/ivCover3"
        app:layout_constraintTop_toTopOf="@+id/ivCover3" />

    <TextView
        android:id="@+id/tvArtist2"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/poppins_regular"
        android:text="Duis vitae"
        android:textColor="@color/snow_white"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@+id/ivCover3"
        app:layout_constraintStart_toEndOf="@+id/ivCover3" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivCover4"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="@+id/ivCover1"
        app:layout_constraintTop_toBottomOf="@+id/ivCover3"
        app:shapeAppearanceOverlay="@style/Circular10"
        app:srcCompat="@drawable/img_album_cover3" />

    <TextView
        android:id="@+id/tvSong3"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Vivamus pharetra"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/ivCover4"
        app:layout_constraintTop_toTopOf="@+id/ivCover4" />

    <TextView
        android:id="@+id/tvArtist3"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/poppins_regular"
        android:text="Proin condimentum rutrum"
        android:textColor="@color/snow_white"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@+id/ivCover4"
        app:layout_constraintStart_toEndOf="@+id/ivCover4" />

    <ImageView
        android:id="@+id/ivPlay2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tvArtist1"
        app:layout_constraintEnd_toEndOf="@+id/tvPlayAll"
        app:layout_constraintTop_toTopOf="@+id/tvSong1"
        app:srcCompat="@android:drawable/ic_media_play" />

    <ImageView
        android:id="@+id/ivPlay3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tvArtist2"
        app:layout_constraintEnd_toEndOf="@+id/tvPlayAll"
        app:layout_constraintTop_toTopOf="@+id/tvSong2"
        app:srcCompat="@android:drawable/ic_media_play" />

    <ImageView
        android:id="@+id/ivPlay4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tvArtist3"
        app:layout_constraintEnd_toEndOf="@+id/tvPlayAll"
        app:layout_constraintTop_toTopOf="@+id/tvSong3"
        app:srcCompat="@android:drawable/ic_media_play" />

    <ImageView
        android:id="@+id/ivPlay5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/ivCover5"
        app:layout_constraintEnd_toEndOf="@+id/tvPlayAll"
        app:layout_constraintTop_toTopOf="@+id/ivCover5"
        app:srcCompat="@android:drawable/ic_media_play" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivCover5"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="@+id/ivCover1"
        app:layout_constraintTop_toBottomOf="@+id/ivCover4"
        app:shapeAppearanceOverlay="@style/Circular10"
        app:srcCompat="@drawable/img_album_cover5" />

    <TextView
        android:id="@+id/tvSong4"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Praesent tellus"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/ivCover5"
        app:layout_constraintTop_toTopOf="@+id/ivCover5" />

    <TextView
        android:id="@+id/tvArtist4"
        style="@style/TextClassic14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/poppins_regular"
        android:text="Lacinia at cursus"
        android:textColor="@color/snow_white"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@+id/ivCover5"
        app:layout_constraintStart_toEndOf="@+id/ivCover5" />

</androidx.constraintlayout.widget.ConstraintLayout>