<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigation_main"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.ambiws.androidarchitecture.features.home.ui.HomeFragment"
        android:label="HomeFragment" >
        <action
            android:id="@+id/action_homeFragment_to_listFragment"
            app:destination="@id/listFragment" />
        <action
            android:id="@+id/action_homeFragment_to_mockGoogleMapsFragment"
            app:destination="@id/mockGoogleMapsFragment" />
    </fragment>

    <fragment
        android:id="@+id/listFragment"
        android:name="com.ambiws.androidarchitecture.features.lists.list.ui.ListFragment"
        android:label="ListFragment" />

    <fragment
        android:id="@+id/mockGoogleMapsFragment"
        android:name="com.ambiws.androidarchitecture.features.design.ui.MockGoogleMapsFragment"
        android:label="MockGoogleMapsFragment" />
</navigation>